# Copy to .env for local use. Keep .env private; the server loads it on startup.
PORT=65111
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:65111
# Optional database override. Existing database files are reused automatically.
# LIVE_SCAVENGER_HUNT_DB=app/data/live-scavenger-hunt.sqlite

# Optional first-boot admin password for hosted deployments. Supply it through
# a platform secret, not a committed .env file. Any nonempty value up to
# 16,384 UTF-8 bytes is accepted; there is no minimum or character rule.
# When set, the password is never printed in server logs. Leave unset locally
# to get the one-time generated password in the startup terminal.
# BOOTSTRAP_ADMIN_PASSWORD=

# Optional Google admin sign-in. Register PUBLIC_BASE_URL plus
# /api/auth/google/callback as an authorized redirect URI in Google Cloud.
# Both values are required; the server accepts only verified @twilio.com
# Workspace accounts and grants them the admin role. Keep the secret private.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Leave blank for automatic behavior: rehearsal without all four Twilio values,
# live Video when the three Video values and Auth Token are present.
# Set on/off to force rehearsal or require full live configuration.
REHEARSAL_MODE=

# Twilio Video room creation and room-scoped browser tokens. Create a Standard
# API key in Twilio's US1 region for the same account as TWILIO_ACCOUNT_SID.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Validates Twilio Video and SMS/WhatsApp webhooks. Not an API Key Secret.
TWILIO_AUTH_TOKEN=

# Optional AI review of object, text, shape, and combination challenges.
# Color rules and operator awards work without OpenAI.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-luna

# Optional Segment mirroring. Local metrics work without a Write Key.
SEGMENT_WRITE_KEY=
# Explicitly opt in before sending an opted-in lead's contact traits to Segment.

# Requested build-guide email is off by default. Set to 1 only after
# authenticating the sender domain and setting both the API key and From address.
# Set to 0 to pause outbound email while keeping lead capture and saved requests.
# Expert requests remain in the lead inbox.
# Mail Send acceptance is not delivery. Add the SendGrid signed Event Webhook
# public verification key to confirm delivery and failures at /webhooks/sendgrid/events.
SENDGRID_EMAIL_ENABLED=0
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY=
# Set to eu for an EU regional SendGrid account; leave blank for global.
SENDGRID_REGION=

# Optional. If blank, the app creates and persists this secret in SQLite.
# Keep it stable across servers/restores so vote identities remain consistent.
VOTE_HMAC_SECRET=

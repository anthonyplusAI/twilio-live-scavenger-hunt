# Copy to .env for local use. Keep .env private; the server loads it on startup.
PORT=65111
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:65111
# Optional database override. Existing database files are reused automatically.
# LIVE_SCAVENGER_HUNT_DB=app/data/live-scavenger-hunt.sqlite

# Optional first-boot admin password for hosted deployments. Supply it through
# a platform secret, not a committed .env file. It must be 24–1024 characters,
# have at least 8 distinct characters, and have no surrounding whitespace.
# When set, the password is never printed in server logs. Leave unset locally
# to get the one-time generated password in the startup terminal.
# BOOTSTRAP_ADMIN_PASSWORD=

# Optional Google operator sign-in. Register PUBLIC_BASE_URL plus
# /api/auth/google/callback as an authorized redirect URI in Google Cloud.
# Both values are required; the server accepts only verified @twilio.com
# Workspace accounts and grants them the operator role. Keep the secret private.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Leave blank for automatic behavior: rehearsal without Video credentials,
# Twilio Video when all three credentials below are present. Set on/off to force.
REHEARSAL_MODE=

# Twilio Video room creation and room-scoped browser tokens.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Validates Twilio Video and SMS/WhatsApp webhooks. Not an API Key Secret.
TWILIO_AUTH_TOKEN=

# Optional AI review of object, text, shape, and combination challenges.
# Color rules and operator awards work without OpenAI.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-luna

# Optional Segment mirroring. Local metrics work without a Write Key.
SEGMENT_WRITE_KEY=
# Explicitly opt in before sending an opted-in lead's contact traits to Segment.
SEGMENT_IDENTIFY_LEADS=0

# Optional requested build-guide emails. Expert requests remain in the lead inbox.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Set to eu for an EU regional SendGrid account; leave blank for global.
SENDGRID_REGION=

# Optional. If blank, the app creates and persists this secret in SQLite.
# Keep it stable across servers/restores so vote identities remain consistent.
VOTE_HMAC_SECRET=
